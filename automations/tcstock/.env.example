TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TCSTOCK_IDNO=
TCSTOCK_PASSWORD=
# Opt in to filling and submitting the visible login form on remote sync runs.
TCSTOCK_AUTO_LOGIN=false
OPENROUTER_API_KEY=
OPENROUTER_CAPTCHA_MODEL=openai/gpt-6-luna
TCSTOCK_HEADLESS=false
TCSTOCK_OUTPUT_DIR=./output
TCSTOCK_PROFILE_DIR=./profile
TCSTOCK_LOGIN_TIMEOUT_MS=180000
# One-off historical backfill only. Leave unset for scheduled 30-day syncs.
# TCSTOCK_TRADES_START_DATE=2026-04-01
# Optional selectors for a separate image verification code on the login form.
TCSTOCK_IMAGE_CODE_SELECTOR=
TCSTOCK_IMAGE_INPUT_SELECTOR=
# Set a five-field schedule on the server. Cron interprets it in the host's timezone.
STOCK_CRON=
# Bind to the server's private VPN IP for direct VPN access, or leave loopback for an SSH tunnel.
TCSTOCK_BIND_IP=127.0.0.1
TCSTOCK_WEB_PORT=8080
TCSTOCK_WEB_USER=
TCSTOCK_WEB_PASSWORD=
# Optional Ledgerly import after each successful trade export.
LEDGERLY_API_URL=
LEDGERLY_API_KEY=
