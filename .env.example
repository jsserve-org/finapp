API_PORT=3000
POSTGRES_USER=ledgerly
POSTGRES_PASSWORD=ledgerly
POSTGRES_DB=ledgerly
# Set this to a managed PostgreSQL URL in cloud deployments. Omit for local Compose PostgreSQL.
# API_DATABASE_URL=postgres://user:password@database-host:5432/ledgerly
# Use a long random value in production. Mobile users exchange a real identity token for this in a later milestone.
API_TOKEN=local-development-token
AUTOMATION_SECRET_KEY=replace-with-32-byte-base64-key
