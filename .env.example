API_PORT=3000
CONVEX_PORT=3210
CONVEX_SITE_PORT=3211
CONVEX_DASHBOARD_PORT=6791
PUBLIC_API_URL=http://localhost:3000
PUBLIC_CONVEX_URL=http://localhost:3210
PUBLIC_CONVEX_SITE_URL=http://localhost:3211
CONVEX_INSTANCE_NAME=ledgerly
# Both secrets must be 64-character hex. Generate each with: openssl rand -hex 32
CONVEX_INSTANCE_SECRET=replace-with-a-long-random-secret
API_SERVICE_SECRET=replace-with-another-long-random-secret
# Fill this after: docker compose exec convex ./generate_admin_key.sh
CONVEX_SELF_HOSTED_ADMIN_KEY=
ALLOW_REGISTRATION=true
